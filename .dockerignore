# Never send runtime secrets, local state, or repository metadata to the Docker daemon.
.git
.github
.claude
.env
.env.*
data
**/__pycache__
**/*.pyc
**/node_modules
webui/dist
control/.venv
.venv
.worktrees
.codex-tmp-*

# Local credentials, packet captures, and editor/OS state.
*.pem
*.key
*.crt
*.pcap
id_rsa*
id_ed25519*
.vscode
.idea
.DS_Store
.smbdelete*
**/.smbdelete*
Thumbs.db
