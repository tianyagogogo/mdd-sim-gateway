{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MddIdd/mdd-sim-gateway/drivers/catalog/schema.json",
  "title": "MDD Sim Gateway NAS compatibility record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "vendor", "product", "platform", "architecture",
    "os", "kernel", "validation", "host_native", "required_modules",
    "tested_usb", "expected_nodes", "driver_pack"
  ],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._+-]*$"},
    "vendor": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "architecture": {"enum": ["x86_64", "aarch64"]},
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1}
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "vermagic"],
      "properties": {
        "release": {"type": "string", "minLength": 1},
        "vermagic": {"type": "string"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "date", "deployment"],
      "properties": {
        "status": {
          "enum": ["reported", "host-native", "driver-verified", "release-ready", "unsupported"]
        },
        "date": {"type": "string", "format": "date"},
        "deployment": {"enum": ["full-container", "host-assisted"]},
        "notes": {"type": "string"}
      }
    },
    "host_native": {"type": "boolean"},
    "required_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
    },
    "tested_usb": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vid", "pid", "kind", "result"],
        "properties": {
          "vid": {"type": "string", "pattern": "^[0-9a-f]{4}$"},
          "pid": {"type": "string", "pattern": "^[0-9a-f]{4}$"},
          "kind": {"enum": ["cellular-modem", "pcsc-reader", "other"]},
          "result": {"enum": ["working", "partial", "not-working"]},
          "notes": {"type": "string"}
        }
      }
    },
    "expected_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["ttyUSB", "ttyACM", "cdc-wdm", "wwan", "usb-bus"]}
    },
    "driver_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "asset", "sha256"],
      "properties": {
        "status": {"enum": ["not-needed", "packaging-pending", "published", "unavailable"]},
        "asset": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
