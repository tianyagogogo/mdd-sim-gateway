ARG BASE_IMAGE=ghcr.io/mddidd/mdd-sim-gateway-control:v1.11.0
FROM ${BASE_IMAGE} AS lpac-build

ARG LPAC_COMMIT=c2fcf5e4b21c712d54e35a11da2ad9ad134fb821
ARG LPAC_SHA256=f3e92f08d10121cf3633cce66853ba1260eb5daa35c594f903cc2720fc11f9ee
ARG DOCKER_CLI_VERSION=27.5.1
ARG DOCKER_CLI_SHA256_AMD64=4f798b3ee1e0140eab5bf30b0edc4e84f4cdb53255a429dc3bbae9524845d640
ARG DOCKER_CLI_SHA256_ARM64=e6b53725a73763ab3f988c73f8772eaed429754c1a579db5ff11f21990fd1817
ARG COMPOSE_VERSION=2.32.4
ARG COMPOSE_SHA256_AMD64=ed1917fb54db184192ea9d0717bcd59e3662ea79db48bff36d3475516c480a6b
ARG COMPOSE_SHA256_ARM64=0c4591cf3b1ed039adcd803dbbeddf757375fc08c11245b0154135f838495a2f

COPY patches/lpac/01_pcsc_reader_selection.patch /tmp/mdd-lpac.patch
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake libcurl4-openssl-dev \
        libpcsclite-dev patch pkg-config wget \
    && cd /tmp \
    && wget -qO lpac.tar.gz \
       "https://github.com/estkme-group/lpac/archive/${LPAC_COMMIT}.tar.gz" \
    && echo "${LPAC_SHA256}  lpac.tar.gz" | sha256sum -c - \
    && tar xf lpac.tar.gz \
    && cd "lpac-${LPAC_COMMIT}" \
    && patch -p1 < /tmp/mdd-lpac.patch \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
         -DSTANDALONE_MODE=ON \
         -DLPAC_WITH_APDU_PCSC=ON -DLPAC_WITH_HTTP_CURL=ON \
         -DLPAC_WITH_APDU_AT=OFF -DLPAC_WITH_APDU_QMI=OFF \
         -DLPAC_WITH_APDU_QMI_QRTR=OFF -DLPAC_WITH_APDU_UQMI=OFF \
         -DLPAC_WITH_APDU_MBIM=OFF -DLPAC_WITH_APDU_GBINDER=OFF \
    && cmake --build build --parallel \
    && DESTDIR=/lpac-root cmake --install build

RUN architecture="$(dpkg --print-architecture)" \
    && case "$architecture" in \
         amd64) docker_arch=x86_64; docker_sum="$DOCKER_CLI_SHA256_AMD64"; compose_arch=x86_64; compose_sum="$COMPOSE_SHA256_AMD64" ;; \
         arm64) docker_arch=aarch64; docker_sum="$DOCKER_CLI_SHA256_ARM64"; compose_arch=aarch64; compose_sum="$COMPOSE_SHA256_ARM64" ;; \
         *) echo "unsupported Docker CLI architecture: $architecture" >&2; exit 1 ;; \
       esac \
    && mkdir -p /docker-tools/cli-plugins \
    && wget -qO /tmp/docker.tgz "https://download.docker.com/linux/static/stable/${docker_arch}/docker-${DOCKER_CLI_VERSION}.tgz" \
    && echo "$docker_sum  /tmp/docker.tgz" | sha256sum -c - \
    && tar -xzf /tmp/docker.tgz -C /tmp \
    && cp /tmp/docker/docker /docker-tools/docker \
    && wget -qO /docker-tools/cli-plugins/docker-compose \
       "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-${compose_arch}" \
    && echo "$compose_sum  /docker-tools/cli-plugins/docker-compose" | sha256sum -c - \
    && chmod 0755 /docker-tools/docker /docker-tools/cli-plugins/docker-compose

FROM ${BASE_IMAGE}

# Keep the released dependency set, replacing the current control plane and prebuilt WebUI.
# lpac runs beside Control because it consumes the same shared PC/SC socket.  DSM never
# needs lpac, pcsc-lite or libccid installed on the host.
COPY --from=lpac-build /lpac-root/usr/local/bin/lpac /usr/local/bin/lpac
COPY --from=lpac-build /docker-tools/docker /usr/local/bin/docker
COPY --from=lpac-build /docker-tools/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY control/app/ /app/control/app/
COPY control/run.py /app/control/run.py
COPY host/mdd_update.py /app/host/mdd_update.py
COPY host/mdd_container_update.py /app/host/mdd_container_update.py
COPY webui/dist/ /app/webui/dist/
COPY VERSION /app/VERSION
RUN apt-get update && apt-get install -y --no-install-recommends curl libcurl4t64 \
    && rm -rf /var/lib/apt/lists/* \
    && printf '/usr/lib64\n' > /etc/ld.so.conf.d/mdd-pcsc.conf && ldconfig
# The released set, plus whatever the current code has added to it (prebuilt wheels only: the
# pins already in the base image are satisfied and nothing is compiled). The control plane
# starts without Pillow or pi-heif, so an overlay whose wheels do not load must fail here.
COPY control/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt \
    && python -c "import PIL.Image, pi_heif"

ENV PYTHONDONTWRITEBYTECODE=1
ARG MDD_VERSION=dev
LABEL io.mdd-sim-gateway.managed="true" \
      io.mdd-sim-gateway.component="control" \
      org.opencontainers.image.version="${MDD_VERSION}"
# Each check is a docker exec that starts a fresh Python: on a Raspberry Pi the three
# containers' checks cost about a fifth of a core at 10 s. The first check now comes
# 30 s after start. --start-interval would keep starts fast, but Docker before 25
# rejects it at build time, and install.sh builds this image with the host's Docker.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c 'import socket; s=socket.create_connection(("127.0.0.1",8443),2); s.close()'
ENTRYPOINT ["python", "run.py"]
