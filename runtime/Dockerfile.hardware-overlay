ARG BASE_IMAGE=mdd-sim-gateway/hardware:dev
FROM ${BASE_IMAGE}

ARG MDD_VERSION=dev
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=
# The same NetworkManager rule as Dockerfile.hardware, which explains it.
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi \
    && if [ -n "${DEBIAN_SECURITY_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        network-manager mobile-broadband-provider-info iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/NetworkManager/conf.d \
    && printf '%s\n' \
        '[main]' \
        'plugins=keyfile' \
        'dns=none' \
        'rc-manager=unmanaged' \
        'no-auto-default=*' \
        '' \
        '[keyfile]' \
        'unmanaged-devices=*,except:interface-name:ww*;except:interface-name:cdc-wdm*' \
        > /etc/NetworkManager/conf.d/90-mdd-cellular-only.conf

COPY runtime/hardware.py /app/runtime/hardware.py
COPY host/modem_probe.py /app/host/modem_probe.py
COPY host/vpcd_modem_bridge.py /app/host/vpcd_modem_bridge.py

LABEL io.mdd-sim-gateway.component="hardware" \
      io.mdd-sim-gateway.managed="true" \
      io.mdd-sim-gateway.experimental="true" \
      io.mdd-sim-gateway.cellular="networkmanager" \
      org.opencontainers.image.version="${MDD_VERSION}"
