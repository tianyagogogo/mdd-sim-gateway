# Build context: repository root. Prepare verified artifacts before building:
# python tools/container-runtime/prepare_egress_assets.py --arch amd64
ARG BASE_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG MDD_VERSION=dev
COPY runtime/vendor/${TARGETARCH}/wheels/ /tmp/wheels/
RUN pip install --no-cache-dir --no-index --find-links=/tmp/wheels PyYAML==6.0.3 \
    && rm -rf /tmp/wheels
COPY runtime/vendor/${TARGETARCH}/bin/ /usr/local/bin/
WORKDIR /app
COPY host/mdd_orchestrator.py /app/host/mdd_orchestrator.py
# The orchestrator imports these at start-up even though Egress never probes a modem.
# tests/test_runtime_image_imports.py fails when an image misses a module it imports.
COPY host/modem_probe.py /app/host/modem_probe.py
COPY host/vpcd_modem_bridge.py /app/host/vpcd_modem_bridge.py
COPY runtime/egress.py /app/runtime/egress.py
COPY control/app/egress_contract.py /app/control/app/egress_contract.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 MDD_EGRESS_HOST=mdd-egress
LABEL io.mdd-sim-gateway.component=egress \
      io.mdd-sim-gateway.managed=true \
      org.opencontainers.image.version="${MDD_VERSION}" \
      org.opencontainers.image.title="MDD Sim Gateway egress plane"
# Each check is a docker exec that starts a fresh Python: on a Raspberry Pi the three
# containers' checks cost about a fifth of a core at 10 s. The first check now comes
# 30 s after start. --start-interval would keep starts fast, but Docker before 25
# rejects it at build time, and install.sh builds this image with the host's Docker.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c 'import json,time; d=json.load(open("/data/orchestrator/socks-egress-status.json")); assert d["transport"]=="socks5" and time.time()-d["updated_at"]<15 and "error_type" not in d'
ENTRYPOINT ["python", "-m", "runtime.egress", "--data", "/data"]
